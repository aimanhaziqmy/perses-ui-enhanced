# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo
.env
.env.*
*.pem
*.key

# Packaged Helm subchart archives / unpacked cache (generated by `helm dependency build`)
/helm/perses-observability/charts/

# Keep only the open-source deliverables tracked in git
/*
!/.gitignore
!/README.md
!/helm/
/helm/*
!/helm/perses-observability/
!/template/
/template/*
!/template/docker/
!/ui/
